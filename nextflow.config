params {
    fastq               =   "*_{1,2}.fastq.gz"
    assemblies          =   false
    assembly_loc        =   "assemblies/*.fasta"
    species             =   "Burkholderia_pseudomallei"
    patientMetaData     =   "${projectDir}/Reports/data/patientMetaData.csv"
    gwas                =   false
    notrim              =   true
    matrix              =   true
    annotate            =   true
    mixtures            =   false
    phylogeny           =   false
    antibiotic_res      =   true
    strain              =   "all"
    tech                =   "Illumina"
    pairing             =   "PE"
    window              =   10000
    indel_merge         =   true
    tri_tetra_allelic   =   false
    size                =   1000000
    phred               =   "-phred33"
    org                 =   "haploid"
    executor            =   "local"
    delly               =   true
    fast                =   true
    hc_chunks           =   4              // HaplotypeCaller pieces per VariantCalling job (see --hc_chunks)
    SE                  =   false          // also run single-end reads from SE/
    fastq_se            =   "SE/*.fastq.gz"

    // EDIT THIS: full path to the built Apptainer image.
    // Can also be set on the command line with --sif /path/to/ardap.sif
    sif                 =   "/path/to/ardap.sif"
}

includeConfig 'configs/gatk.config'

// All tools now come from the Apptainer image, so the conda block was removed.
// 'singularity' is the scope name that works on old and new Nextflow versions;
// Apptainer provides a compatible 'singularity' command.
singularity {
    enabled    = true
    autoMounts = true
    // Makes Databases/, resources/ and bin/ readable inside the container
    // even if the pipeline folder is outside your home directory
    runOptions = "-B ${projectDir}"
}

// Note: cleanup = true deletes each run's work directory on success, which keeps
// file counts down but means -resume cannot be used. Set to false to use -resume.
cleanup = true

process {

    container = params.sif

    // Moved inside the process scope (at the top level it had no effect).
    // Tasks run in node-local scratch space if the executor provides it.
    scratch = true

    executor = params.executor

    // Retry failed tasks up to 3 times (memory scales with attempt below),
    // then skip the sample. Previously "ignore" meant retries never happened.
    errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
    maxRetries = 4

    withLabel: art {
        cpus = 1
        memory = { 4.GB * task.attempt }
        time = "8h"
    }

    withLabel: card {
        cpus = 1
        memory = "4G"
        time = "8h"
    }

    withLabel: index {
        cpus = 1
        memory = "4G"
        time = "8h"
    }

    withLabel: ardap_default {
        cpus = 2
        memory = { 4.GB * task.attempt }
        time = "4h"
    }

    withLabel: alignment {
        cpus = 4
        memory = { 4.GB * task.attempt }
        time = "4h"
    }
    withLabel: trimmomatic {
        cpus = 2
        memory = { 4.GB * task.attempt }
        time = "4h"
    }
    withLabel: markduplicates {
        cpus = 2
        memory = { 4.GB * task.attempt }
        time = "4h"
    }
    withLabel: gatk_haplo {
        cpus = 4
        memory = { 4.GB * task.attempt }
        time = "4h"
    }
    withLabel: gatk {
        cpus = 4
        memory = { 4.GB * task.attempt }
        time = "4h"
    }

    withLabel: snpeff {
        cpus = 1
        memory = { 4.GB * task.attempt }
        time = "4h"
    }

    withLabel: pindel {
        cpus = 2
        memory = { 4.GB * task.attempt }
        time = "4h"
    }

    withLabel: genomic_queries {
        cpus = 1
        memory = "4G"
        time = "8h"
    }

    withLabel: card_queries {
        cpus = 1
        memory = "4G"
        time = "2h"
    }

    withLabel: report {
        cpus = 1
        memory = "4G"
        time = "2h"
    }

    withLabel: master_vcf {
        cpus = 1
        memory = { 4.GB * task.attempt }
        time = "4h"
    }
    withLabel: snp_matrix {
        cpus = 1
        memory = { 4.GB * task.attempt }
        time = "4h"
    }
}

manifest {
    homePage = 'http://github.com/dsarov/ARDaP'
    description = 'Comprehensive resistance detection from WGS'
    mainScript = 'main.nf'
    version = '3.0'
    nextflowVersion = '!>=25.10.0'
}
